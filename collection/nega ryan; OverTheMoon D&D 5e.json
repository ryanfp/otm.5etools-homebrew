	"itemProperty": [
		{
			"name": "Aerodynamic",
			"abbreviation": "AER",
			"source": "OTMDnD5e",
			"template": "{{prop_name}}",
			"entries": [
				{
					"type": "entries",
					"name": "Aerodynamic",
					"entries": [
						"When you throw this weapon, it deals the damage shown in parentheses instead of its normal damage."
					]
				}
			]
		},
		{
			"name": "Agile",
			"abbreviation": "AGI",
			"source": "OTMDnD5e",
			"template": "{{prop_name}}",
			"entries": [
				{
					"type": "entries",
					"name": "Agile",
					"entries": [
						"This weapon can be drawn or stowed as a {@variantrule Reaction|XPHB} or part of the {@action Attack|XPHB} action."
					]
				}
			]
		},
		{
			"name": "Cumbersome",
			"abbreviation": "CUM",
			"source": "OTMDnD5e",
			"template": "{{prop_name}}",
			"entries": [
				{
					"type": "entries",
					"name": "Cumbersome",
					"entries": [
						"This weapon is much bulkier than normal, and creatures who wield can only equip or stow it as an {@action |XPHB}."
					]
				}
			]
		},
		{
			"name": "Armor Piercing",
			"abbreviation": "AP",
			"source": "OTMDnD5e",
			"template": "{{prop_name}}",
			"entries": [
				{
					"type": "entries",
					"name": "Armor Piercing",
					"entries": [
						"This weapon ignores {@variantrule Resistance|XPHB} to piercing damage and treats {@variantrule Immunity|XPHB} to piercing damage as Resistance. It also ignores instances of nonmagical Damage Reduction granted by armor."
					]
				}
			]
		},
		{
			"name": "Brutal",
			"abbreviation": "BRU",
			"source": "OTMDnD5e",
			"template": "{{prop_name}}",
			"entries": [
				{
					"type": "entries",
					"name": "Brutal",
					"entries": [
						"When you score a {@variantrule Critical Hit|XPHB} with this weapon, roll one additional weapon damage die when determining the extra damage."
					]
				}
			]
		},
		{
			"name": "Concussive",
			"abbreviation": "CON",
			"source": "OTMDnD5e",
			"template": "{{prop_name}}",
			"entries": [
				{
					"type": "entries",
					"name": "Concussive",
					"entries": [
						"Damage from this weapon counts as both bludgeoning and piercing; the target applies whichever of its {@variantrule Resistance|XPHB|resistances}, {@variantrule Immunity|XPHB|immunities}, or {@variantrule Vulnerability|XPHB|vulnerabilities} to those types is least favorable to it. {@variantrule Resistance|XPHB} to all physical damage applies as normal."
					]
				}
			]
		},
		{
			"name": "Defensive",
			"abbreviation": "DEF",
			"source": "OTMDnD5e",
			"template": "{{prop_name}}",
			"entries": [
				{
					"type": "entries",
					"name": "Defensive",
					"entries": [
						"While you wield one or more weapons with this property, you gain a +1 bonus to your {@variantrule AC|XPHB} if you are Proficient in the weapon and not using a shield."
					]
				}
			]
		},
		{
			"name": "Heavy",
			"abbreviation": "H",
			"source": "OTMDnD5e",
			"template": "{{prop_name}}",
			"entries": [
				{
					"type": "entries",
					"name": "Heavy",
					"entries": [
						"You have {@variantrule Disadvantage|XPHB} on Attack Rolls with a Heavy weapon if it's a Melee weapon and your Strength score isn't at least 13 or if it's a Ranged weapon and your Dexterity score isn't at least 13. This weapon always requires a full {@variantrule Action|XPHB} to draw, stow, or reload, unless otherwise noted."
					]
				}
			]
		},
		{
			"name": "Indirect",
			"abbreviation": "IND",
			"source": "OTMDnD5e",
			"template": "{{prop_name}}",
			"entries": [
				{
					"type": "entries",
					"name": "Indirect",
					"entries": [
						"This weapon ignores the AC bonus granted by shields."
					]
				}
			]
		},
		{
			"name": "Parry",
			"abbreviation": "PAR",
			"source": "OTMDnD5e",
			"template": "{{prop_name}}",
			"entries": [
				{
					"type": "entries",
					"name": "Parry",
					"entries": [
						"This weapon has been designed to help you parry blows. While wielding this weapon, you can use your {@variantrule Reaction|XPHB} when you are hit by a melee attack to gain a +2 bonus to AC against the triggering attack, potentially causing it to miss."
					]
				}
			]
		},
		{
			"name": "Precise",
			"abbreviation": "PRC",
			"source": "OTMDnD5e",
			"template": "{{prop_name}}",
			"entries": [
				{
					"type": "entries",
					"name": "Precise",
					"entries": [
						"This weapon can fire within its Long Range without suffering {@variantrule Disadvantage|XPHB} on its {@variantrule Attack Roll|XPHB}, and treats {@variantrule Cover|XPHB} as one step less (3/4ths Cover treated as ½ Cover, ½ Cover treated as none)."
					]
				}
			]
		},
		{
			"name": "Reach",
			"abbreviation": "R",
			"source": "OTMDnD5e",
			"template": "{{prop_name}}",
			"entries": [
				{
					"type": "entries",
					"name": "Reach",
					"entries": [
						"This weapon adds the number of feet shown in parentheses to your reach when you attack with it, as well as when determining your reach for {@action Opportunity Attack|XPHB|Opportunity Attacks} with it."
					]
				}
			]
		},
		{
			"name": "Reload",
			"abbreviation": "RLD",
			"source": "OTMDnD5e",
			"template": "{{prop_name}}",
			"entries": [
				{
					"type": "entries",
					"name": "Reload",
					"entries": [
						"This weapon can be fired a number of times equal to its reload score before it must be reloaded before it can be fired again. Reloading takes an {@variantrule Action|XPHB|action} or {@variantrule Bonus Action|XPHB}. You must have a free hand to reload a firearm."
					]
				}
			]
		},
		{
			"name": "Scatter",
			"abbreviation": "SCT",
			"source": "OTMDnD5e",
			"template": "{{prop_name}}",
			"entries": [
				{
					"type": "entries",
					"name": "Scatter",
					"entries": [
						"This weapon instead fires a spread of bullets in a cone equal in distance to its Short Range. Targets within the area must succeed on a Reflex Saving Throw equal to your Exploit DC. On a success, the targets receive half damage, while on a failure they receive full damage."
					]
				}
			]
		},
		{
			"name": "Special",
			"abbreviation": "S",
			"source": "OTMDnD5e",
			"template": "{{prop_name}}",
			"entries": [
				{
					"type": "entries",
					"name": "Special",
					"entries": [
						"This weapon has a custom property that is detailed in this description."
					]
				}
			]
		},
		{
			"name": "Subtle",
			"abbreviation": "SUB",
			"source": "OTMDnD5e",
			"template": "{{prop_name}}",
			"entries": [
				{
					"type": "entries",
					"name": "Subtle",
					"entries": [
						"You have {@variantrule Advantage|XPHB} on {@skill Stealth|XPHB} (Dexterity) or {@skill Sleight of Hand|XPHB} (Dexterity) checks made to hide or conceal this weapon."
					]
				}
			]
		},
		{
			"name": "Unsportsmanlike",
			"abbreviation": "UNS",
			"source": "OTMDnD5e",
			"template": "{{prop_name}}",
			"entries": [
				{
					"type": "entries",
					"name": "Unsportsmanlike",
					"entries": [
						"Deal an extra die of damage when this weapon hits a creature that is {@condition Prone|XPHB}, {@condition Restrained|XPHB}, or Exposed."
					]
				}
			]
		}
	],
